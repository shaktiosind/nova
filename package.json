{
  "name": "nova-lang",
  "version": "2.0.1",
  "description": "Nova scripting language — beginner-friendly syntax with a practical application runtime.",
  "main": "dist/main.js",
  "bin": {
    "nova": "./bin/nova"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "repl": "node dist/main.js repl",
    "dev": "tsc && node dist/main.js repl",
    "check": "node dist/main.js check",
    "test": "npm run build && node tests/run-tests.js",
    "pack": "npm pack"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "bin",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "docs"
  ],
  "keywords": [
    "programming-language",
    "scripting-language",
    "beginner",
    "interpreter",
    "sqlite",
    "http",
    "html",
    "nova"
  ],
  "license": "MIT"
}
